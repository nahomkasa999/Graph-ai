{
  "name": "flowlens-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"**/fixtures/**\" --exclude \"**/browser/**\"",
    "test:ui": "playwright test --config browser/playwright.config.ts",
    "demo": "node packages/cli/dist/index.js dev examples/notes-app",
    "demo:traced": "pnpm --filter @flowlens/notes-app start:traced",
    "demo:traffic": "pnpm --filter @flowlens/notes-app traffic"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.65.0"
  }
}
