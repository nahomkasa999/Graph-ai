{
  "name": "@flowlens/tracer",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/register.ts src/loader.ts src/runtime.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.28.0",
    "@flowlens/core": "workspace:*",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.301.1",
    "@opentelemetry/instrumentation-http": "~0.301.1",
    "@opentelemetry/sdk-node": "~0.301.1",
    "@opentelemetry/sdk-trace": "~3.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.0"
  }
}
